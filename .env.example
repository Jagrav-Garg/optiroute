# Cline API key — used as the LLM provider gateway for all agents
CLINE_API_KEY=cline_...

# SerpAPI key — used by specialist agents for flight/hotel/place searches
SERPAPI_KEY=your_serpapi_key_here

# Google Maps API key — used by the routing engine for distance matrix + geocoding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional overrides
CLINE_MODEL_ID=anthropic/claude-sonnet-4.6
MAX_ITERATIONS=10
