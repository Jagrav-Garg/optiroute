MODEL_PROVIDER=openrouter
CLINE_API_KEY=
CLINE_MODEL=inclusionai/ling-3.1-flash
CLINE_PLANNER_MODEL=inclusionai/ling-3.1-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_PLANNER_MODEL=qwen/qwen3.8-27b:free
# Paid models require an explicit opt-in. No automatic paid fallback.
ALLOW_PAID_MODELS=false
MAX_RUN_COST_USD=0.03
MAX_TOTAL_COST_USD=0.25
MAX_MODEL_CALLS_PER_AGENT=3
MAX_SEARCHES_PER_AGENT=2
MODEL_TIMEOUT_SECONDS=90
AGENT_TIMEOUT_SECONDS=240

