{
  "name": "optiroute-cline-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cline SDK agent worker for the OptiRoute travel-planning graph",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && vite build --config frontend/vite.config.js",
    "build:worker": "tsc",
    "build:ui": "vite build --config frontend/vite.config.js",
    "dev:ui": "vite --config frontend/vite.config.js --host 127.0.0.1",
    "test:ui": "node scripts/check_chat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cline/sdk": "0.0.90",
    "@cline/shared": "0.0.90",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
